# =============================================================================
# CarDamageAI backend - example environment file
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Application -------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
DEBUG=true
APP_NAME=CarDamageAI API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_JSON=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=https://dentsense.vercel.app,http://localhost:3000,http://localhost:5173

# --- Roboflow (server-side only, never exposed to clients) -------------------
ROBOFLOW_API_KEY=your-roboflow-private-api-key
ROBOFLOW_MODEL_ID=car-damage-wpmh2/1
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_TIMEOUT_SECONDS=30

# --- Groq (AI repair cost estimation, PKR) -----------------------------------
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30
PRICING_RATE_LIMIT_PER_MINUTE=10

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_PIXELS=50000000
DAMAGE_DETECT_RATE_LIMIT_PER_MINUTE=10

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://ivdlmmkijtbcrzhiaypp.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy anon JWT (used for GoTrue auth requests when set)
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_STORAGE_BUCKET=damage-images
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
SUPABASE_HTTP_TIMEOUT_SECONDS=15

# --- Authentication ----------------------------------------------------------
PASSWORD_MIN_LENGTH=8
AUTH_SIGNUP_RATE_LIMIT_PER_MINUTE=5
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=30

# --- Nearby mechanics (OpenStreetMap / Overpass / OSRM) ----------------------
OVERPASS_API_URL=https://overpass.kumi.systems/api/interpreter
OSRM_API_URL=https://router.project-osrm.org
MECHANIC_SEARCH_RADIUS_M=10000
MECHANIC_SEARCH_MAX_RESULTS=20
MECHANIC_HTTP_TIMEOUT_SECONDS=25
MECHANIC_RATE_LIMIT_PER_MINUTE=20
GEOAPIFY_API_KEY=your-geoapify-api-key

# --- WhatsApp ----------------------------------------------------------------
WHATSAPP_DEFAULT_COUNTRY_CODE=92
WHATSAPP_DEFAULT_MESSAGE_PREFIX=Hello, I would like a repair quotation for my vehicle based on the damage report below.

# --- Security ----------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
